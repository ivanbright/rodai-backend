# Import these suggested values into the Railway RodAI API service.
# Replace the local-only secret before deploying; production startup rejects it.
RODAI_ENV=production
RODAI_SECRET_KEY=local-development-only-change-before-deploy
DATABASE_URL=postgresql+psycopg://${{Postgres.PGUSER}}:${{Postgres.PGPASSWORD}}@${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}
RODAI_DATA_DIR=/var/lib/rodai
RODAI_MODEL_DIR=/var/lib/rodai/models
RODAI_ALLOWED_ORIGINS=https://rodai.cursorclick.dev
RODAI_MAX_UPLOAD_MB=500
RODAI_MAX_VIDEO_SECONDS=600
RODAI_MAX_CONCURRENT_SESSIONS=1
RODAI_UPLOAD_RETENTION_DAYS=7
RODAI_RESULTS_RETENTION_DAYS=30
RODAI_EXPORTS_RETENTION_DAYS=7
RODAI_RETENTION_SWEEP_INTERVAL_SECONDS=3600
RODAI_CAMERA_MAX_WIDTH=1280
RODAI_CAMERA_MAX_HEIGHT=720
RODAI_CAMERA_JPEG_QUALITY=0.82
RODAI_DEVICE=cpu
RODAI_DETECTION_MODEL=facebook/detr-resnet-50
RODAI_DETECTION_MODEL_REVISION=70120ba84d68ca1211e007c4fb61d0cd5424be54
RODAI_DETECTION_THRESHOLD=0.35
RODAI_INFERENCE_IMGSZ=640
RODAI_ANALYSIS_FPS=2
RODAI_LOG_LEVEL=INFO

