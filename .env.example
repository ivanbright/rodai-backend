# Runtime environment: local, staging, or production
RODAI_ENV=local
PORT=8000
DATABASE_URL=postgresql+psycopg://rodai:rodai-local-only@postgres:5432/rodai
RODAI_DATA_DIR=/var/lib/rodai
RODAI_MODEL_DIR=/var/lib/rodai/models
RODAI_ALLOWED_ORIGINS=http://localhost:5173
# Replace before any shared or public deployment. Never commit a real secret.
RODAI_SECRET_KEY=replace-with-a-random-secret-before-deployment
RODAI_MAX_UPLOAD_MB=500
RODAI_MAX_VIDEO_SECONDS=600
RODAI_MAX_CONCURRENT_SESSIONS=1
RODAI_DEVICE=cpu
RODAI_DETECTION_MODEL=unavailable
RODAI_INFERENCE_IMGSZ=640
RODAI_LOG_LEVEL=INFO
